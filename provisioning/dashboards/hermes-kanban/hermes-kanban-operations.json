          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE status\n    WHEN 'done' THEN '완료'\n    WHEN 'archived' THEN '보관'\n    WHEN 'blocked' THEN '차단'\n    WHEN 'running' THEN '실행 중'\n    WHEN 'triage' THEN '검토'\n    ELSE status\n  END AS metric,\n  count(*) AS value\nFROM observability.hermes_kanban_tasks\nWHERE $__timeFilter(created_at)\n  AND board ~ '${board:regex}'\n  AND status ~ '${status:regex}'\n  AND assignee ~ '${assignee:regex}'\nGROUP BY status\nORDER BY value DESC;",
          "refId": "A"
        }
