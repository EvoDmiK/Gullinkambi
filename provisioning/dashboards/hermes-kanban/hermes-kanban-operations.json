          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  board AS \"보드\",\n  task_id AS \"작업 ID\",\n  title AS \"제목\",\n  title_hash AS \"제목 해시\",\n  assignee AS \"담당자\",\n  CASE status\n    WHEN 'done' THEN '완료'\n    WHEN 'archived' THEN '보관'\n    WHEN 'blocked' THEN '차단'\n    WHEN 'running' THEN '실행 중'\n    WHEN 'triage' THEN '검토'\n    ELSE status\n  END AS \"상태\",\n  parent_count AS \"상위 작업 수\",\n  child_count AS \"하위 작업 수\",\n  run_count AS \"실행 수\",\n  comment_count AS \"댓글 수\",\n  attachment_count AS \"첨부 수\"\nFROM observability.hermes_kanban_tasks\nWHERE $__timeFilter(created_at)\n  AND board ~ '${board:regex}'\n  AND assignee ~ '${assignee:regex}'\n  AND (parent_count > 0 OR child_count > 0)\nORDER BY child_count DESC, parent_count DESC, created_at DESC\nLIMIT 100;",
          "refId": "A"
        }
