      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ffskrzljzwr28b"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, $__interval),\n  CASE run_result\n    WHEN 'completed' THEN '완료'\n    WHEN 'done' THEN '완료'\n    WHEN 'blocked' THEN '차단'\n    WHEN 'crashed' THEN '실패'\n    WHEN 'reclaimed' THEN '회수'\n    WHEN 'timed_out' THEN '시간 초과'\n    WHEN 'running' THEN '실행 중'\n    WHEN 'unknown' THEN '알 수 없음'\n    ELSE run_result\n  END AS metric,\n  count(*) AS value\nFROM (\n  SELECT\n    COALESCE(ended_at, started_at) AS event_time,\n    board,\n    COALESCE(NULLIF(outcome, ''), NULLIF(status, ''), 'unknown') AS run_result\n  FROM observability.hermes_kanban_task_runs\n) AS runs\nWHERE $__timeFilter(event_time)\n  AND board ~ '${board:regex}'\nGROUP BY 1, run_result\nORDER BY 1, run_result;",
          "refId": "A"
        }
      ],
      "title": "작업 실행 결과 추이",
      "type": "timeseries"
