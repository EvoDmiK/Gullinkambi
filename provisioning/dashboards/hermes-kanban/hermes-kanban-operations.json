          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(last_heartbeat_at, started_at, created_at) AS \"시각\",\n  board AS \"보드\",\n  task_id AS \"작업 ID\",\n  title AS \"제목\",\n  title_hash AS \"제목 해시\",\n  assignee AS \"담당자\",\n  CASE status\n    WHEN 'running' THEN '실행 중'\n    WHEN 'blocked' THEN '차단'\n    WHEN 'triage' THEN '검토'\n    ELSE status\n  END AS \"상태\",\n  latest_run_status AS \"최근 실행 상태\",\n  latest_run_outcome AS \"최근 실행 결과\",\n  consecutive_failures AS \"연속 실패 수\",\n  block_kind AS \"차단 유형\",\n  run_count AS \"실행 수\",\n  result_present AS \"결과 존재\"\nFROM observability.hermes_kanban_tasks\nWHERE $__timeFilter(COALESCE(last_heartbeat_at, started_at, created_at))\n  AND board ~ '${board:regex}'\n  AND assignee ~ '${assignee:regex}'\n  AND status IN ('running', 'blocked', 'triage')\nORDER BY COALESCE(last_heartbeat_at, started_at, created_at) DESC\nLIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "진행 중·차단·검토 작업",
      "type": "table"
