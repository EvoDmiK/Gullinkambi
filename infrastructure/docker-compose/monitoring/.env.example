TZ=Asia/Seoul

GF_DATABASE_TYPE=postgres
GF_DATABASE_HOST=postgres-n8n:5432
GF_DATABASE_NAME=n8n
GF_DATABASE_USER=grafana
GF_DATABASE_PASSWORD=change-me
GF_DATABASE_SSL_MODE=disable
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_DOMAIN=monitoring.example.com
GF_SERVER_ROOT_URL=https://monitoring.example.com/
GF_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

POSTGRES_EXPORTER_DATA_SOURCE_NAME=postgresql://postgres_exporter:change-me@postgres-n8n:5432/n8n?sslmode=disable

TS_HOSTNAME_GRAFANA=dove-grafana
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Separate read-only users, created on the existing databases before provisioning.
OBSERVABILITY_DB_HOST=timescaledb:5432
OBSERVABILITY_DB_NAME=timeseries
OBSERVABILITY_DB_USER=grafana_reader
OBSERVABILITY_DB_PASSWORD=change-me
N8N_DB_HOST=postgres-n8n:5432
N8N_DB_NAME=n8n
N8N_DB_USER=grafana_n8n_reader
N8N_DB_PASSWORD=change-me
