{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORCA task/attempt manifest (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_id",
    "task_id",
    "attempt_id",
    "project_key",
    "revision"
  ],
  "oneOf": [
    {
      "required": [
        "request_ids"
      ]
    },
    {
      "required": [
        "request_id_hashes"
      ]
    },
    {
      "required": [
        "window"
      ],
      "anyOf": [
        {
          "required": [
            "session_id"
          ]
        },
        {
          "required": [
            "session_id_hash"
          ]
        }
      ]
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$",
      "description": "sha256(value)[:24], as produced by orca_calls._hash"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "producer_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "parent_task_id": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "$ref": "#/$defs/id"
    },
    "project_key": {
      "$ref": "#/$defs/id"
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 256
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "description": "UTC half-open interval [start, end)",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "session_id_hash": {
      "$ref": "#/$defs/hash"
    },
    "request_id_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hash"
      }
    }
  }
}
