<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gullinkambi.codex-thread-names</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/python@3.14/bin/python3.14</string>
    <string>/Users/example/Library/Application Support/Gullinkambi/codex_thread_names_snapshot.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/example/Library/Logs/Gullinkambi/codex-thread-names.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/example/Library/Logs/Gullinkambi/codex-thread-names.error.log</string>
</dict>
</plist>
