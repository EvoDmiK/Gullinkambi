// Mac mini log shipper: container logs (Docker socket) and Hermes file logs -> Loki on the NAS.
// Secrets are masked before anything leaves the machine. Keep the masking rules in sync with
// docker-data/monitoring/alloy/config.alloy (NAS).
logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }

  // `service` is the one label to filter by: the compose service name, or the container name.
  rule {
    source_labels = ["container"]
    target_label  = "service"
  }

  rule {
    source_labels = ["compose_service"]
    regex         = "(.+)"
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.mask.receiver]
}

// Hermes writes plain log files; agent.log and errors.log are enough (rotated copies are skipped).
local.file_match "hermes" {
  path_targets = [
    {__path__ = "/opt/hermes/profiles/*/logs/agent.log", service = "hermes", log_file = "agent"},
    {__path__ = "/opt/hermes/profiles/*/logs/errors.log", service = "hermes", log_file = "errors"},
    {__path__ = "/opt/hermes/logs/agent.log", service = "hermes", log_file = "agent"},
    {__path__ = "/opt/hermes/logs/errors.log", service = "hermes", log_file = "errors"},
  ]
}

loki.source.file "hermes" {
  targets       = local.file_match.hermes.targets
  tail_from_end = true
  forward_to    = [loki.process.hermes.receiver]
}

loki.process "hermes" {
  // Only the profile name is taken from the path; it becomes a label.
  stage.regex {
    source     = "filename"
    expression = `/profiles/(?P<profile>[^/]+)/logs/`
  }
  stage.labels {
    values = {profile = ""}
  }
  forward_to = [loki.process.mask.receiver]
}

// Secrets must never reach Loki: each expression has one capture group, which is replaced.
loki.process "mask" {
  stage.replace {
    expression = `(?i)bearer\s+([A-Za-z0-9._~+/=\-]{16,})`
    replace    = "***"
  }
  stage.replace {
    expression = `(?i)(?:password|passwd|secret|token|api[_-]?key|authorization|auth_key)["']?\s*[:=]\s*["']?([^\s"',;&]{4,})`
    replace    = "***"
  }
  stage.replace {
    expression = `(eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,})`
    replace    = "***"
  }
  stage.replace {
    expression = `://[^/\s:@]+:([^@\s]+)@`
    replace    = "***"
  }
  stage.replace {
    expression = `(sk-[A-Za-z0-9_\-]{20,})`
    replace    = "***"
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")
  }
  external_labels = {
    host = "macmini",
  }
}
