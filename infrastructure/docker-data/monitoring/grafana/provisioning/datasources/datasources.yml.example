apiVersion: 1

datasources:
  - name: Prometheus
    uid: PBFA97CFB590B2093
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true

  - name: Loki
    type: loki
    access: proxy
    url: http://loki:3100

  - name: Observability
    uid: ffskrzljzwr28b
    type: postgres
    access: proxy
    url: ${OBSERVABILITY_DB_HOST}
    user: ${OBSERVABILITY_DB_USER}
    secureJsonData:
      password: ${OBSERVABILITY_DB_PASSWORD}
    jsonData:
      database: ${OBSERVABILITY_DB_NAME}
      sslmode: require
      postgresVersion: 1600
      timescaledb: true

  - name: n8n
    uid: cfrgthsaa3ev4b
    type: postgres
    access: proxy
    url: ${N8N_DB_HOST}
    user: ${N8N_DB_USER}
    secureJsonData:
      password: ${N8N_DB_PASSWORD}
    jsonData:
      database: ${N8N_DB_NAME}
      sslmode: require
      postgresVersion: 1600
